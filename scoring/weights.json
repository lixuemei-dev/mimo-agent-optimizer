    },
    "cost": {
      "max": 5.0,
      "unit": "USD",
      "lowerIsBetter": true
    },
    "quality": {
      "max": 1.0,
      "unit": "score",
      "higherIsBetter": true
    }
  },
  "bonuses": {
    "streamingEnabled": -500,
    "parallelToolsEnabled": -300,
    "cacheEnabled": -200,
    "deduplicationEnabled": -400
  },
  "penalties": {
    "missingTimeout": 1000,
    "excessiveToolDepth": 500,
    "noBudgetCap": 800
